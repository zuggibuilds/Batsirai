{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@batsirai/shared": ["packages/shared/src/index"],
      "@batsirai/shared/*": ["packages/shared/src/*"],
      "@batsirai/config": ["packages/config/src/index"],
      "@batsirai/config/*": ["packages/config/src/*"]
    }
  }
}
